#usda 1.0
(
    defaultPrim = "Bottle"
    metersPerUnit = 1
    upAxis = "Z"
)

# 药瓶按压喷嘴 articulation：
#   base  —— 瓶体(固定于世界)  FixedJoint -> world
#   nozzle—— 按压嘴            PrismaticJoint(Z) 相对 base，行程 lower=4mm(压下触发)，弹簧回位
# 单位均为米。压下喷嘴 = joint position 走负方向至 lowerLimit(≈-0.004)。
# 物理量：弹簧 stiffness/damping、行程、质量等集中在本文件便于离线校验。

def Xform "Bottle" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    uniform token[] xformOpOrder = []
    bool physxArticulation:articulationEnabled = 1

    # ---------------- base : 瓶体（世界固定） ----------------
    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        uniform token[] xformOpOrder = []
        bool physics:rigidBodyEnabled = 1
        bool physics:kinematicEnabled = 0
        float physics:mass = 0.3
        float3 physics:diagonalInertia = (0.0005, 0.0005, 0.0002)
        float physics:angularDamping = 0.1
        float physics:linearDamping = 0.1
        bool physxRigidBody:disableGravity = 0

        def Cylinder "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.1
            double radius = 0.022
            float3 xformOp:translate = (0, 0, 0.05)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            bool physics:collisionEnabled = 1
        }
        # 瓶口颈部（仅视觉，关闭碰撞：喷嘴下压时需滑入其内侧空间，避免起始穿透）
        def Cylinder "neck" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.025
            double radius = 0.016
            float3 xformOp:translate = (0, 0, 0.11)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            bool physics:collisionEnabled = 0
        }
        # 肩部视觉过渡（无碰撞）
        def Cylinder "shoulder_visual"
        {
            uniform token axis = "Z"
            double height = 0.012
            double radius = 0.0235
            float3 xformOp:translate = (0, 0, 0.112)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    # ---------------- nozzle : 按压嘴（沿 Z 上下滑动） ----------------
    def Xform "nozzle" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        uniform token[] xformOpOrder = []
        bool physics:rigidBodyEnabled = 1
        bool physics:kinematicEnabled = 0
        float physics:mass = 0.012
        float3 physics:diagonalInertia = (1e-6, 1e-6, 1e-6)
        bool physxRigidBody:disableGravity = 0

        # 喷头本体：下缘 home 在 z=0.105（不插进瓶口），顶端 z≈0.145
        def Cylinder "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.04
            double radius = 0.011
            float3 xformOp:translate = (0, 0, 0.125)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            bool physics:collisionEnabled = 1
        }
        # 喷口视觉细段（无碰撞）
        def Cylinder "tip_visual"
        {
            uniform token axis = "Z"
            double height = 0.006
            double radius = 0.008
            float3 xformOp:translate = (0, 0, 0.148)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    # ---------------- joints ----------------
    def PhysicsFixedJoint "base_to_world"
    {
        rel physics:body0 = None
        rel physics:body1 = </Bottle/base>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }

    def PhysicsPrismaticJoint "nozzle_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
    )
    {
        uniform token physics:axis = "Z"
        rel physics:body0 = </Bottle/base>
        rel physics:body1 = </Bottle/nozzle>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -0.004
        float physics:upperLimit = 0.001
        # 复位弹簧：K=2000N/m, 全行程恢复力≈8N, 行程尽头≈触发
        float drive:linear:physics:stiffness = 2000.0
        float drive:linear:physics:damping = 8.0
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:maxForce = 30.0
        uniform token drive:linear:physics:type = "force"
        float state:linear:physics:position = 0.0
        float state:linear:physics:velocity = 0.0
    }
}
